# TrustBridge API: copy to backend/.env and fill in.
# Never commit the real file. Optional services fail gracefully when unset.

# --- Server ---
PORT=5000
NODE_ENV=development
# Public URL of the frontend. Used for CORS, OAuth redirects and email links.
# Comma-separate multiple origins if you need more than one.
FRONTEND_URL=http://localhost:5173

# --- Auth ---
# REQUIRED in production (min 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Stellar ---
# "testnet" or "mainnet". Use testnet for development.
STELLAR_NETWORK=testnet

# --- Email notifications (Resend), optional ---
EMAIL_API_KEY=
EMAIL_FROM=TrustBridge <onboarding@resend.dev>
# Public URL of this API, used to build unsubscribe links
API_BASE_URL=http://localhost:5000

# --- Campaign image upload (Cloudinary), optional ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- GitHub login (OAuth app), optional ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
